# Copy to your shell/service environment; never commit secrets.
# URLs end in /v1; the worker appends /chat/completions.
XIAMI_PYTHON=/absolute/path/to/venv/python
XIAMI_PIVOT_URL=http://127.0.0.1:8000/v1
XIAMI_PIVOT_MODEL=Qwen/Qwen2.5-7B-Instruct
XIAMI_PIVOT_KEY=
XIAMI_CANTONESE_URL=
XIAMI_CANTONESE_MODEL=
XIAMI_CANTONESE_KEY=
XIAMI_HOKKIEN_URL=
XIAMI_HOKKIEN_MODEL=
XIAMI_HOKKIEN_KEY=
# Default OFF. Enable only after informing the user that selected crops go to Azure.
XIAMI_CLOUD_OCR_OPT_IN=0
XIAMI_AZURE_VISION_URL=
XIAMI_AZURE_VISION_KEY=
TESSERACT_CMD=
